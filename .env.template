# DeepSeek（必填，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 当前供应商：deepseek | openai | claude
LLM_PROVIDER=deepseek

# 预留：切换供应商时再填
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 存储与检索
SQLITE_PATH=data/personal_ai.db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 工作流
LOG_LEVEL=INFO
# 一轮里最多连续调用几次工具。建议 3–8。越大越能多步做事，也更慢更费额度
MAX_TOOL_ITERATIONS=8
# 最近几轮对话留给模型当上下文。建议 8–24
SHORT_TERM_WINDOW=16

# 感官（改完重启 run.bat。true/false 不要加引号）
VOICE_ENABLED=true
TTS_ENABLED=true
# 识别：sensevoice=本地中文（推荐） | whisper=备用 | auto=先 SenseVoice 再 Whisper
STT_ENGINE=sensevoice
# 仅 STT_ENGINE=whisper 时有用：tiny / base / small（越大越准、越慢）
STT_MODEL=base
SENSEVOICE_DIR=models/sensevoice
# 播报引擎：edge=微软神经网络（需能访问微软语音） | sapi=系统慧慧（断网也能说）
TTS_ENGINE=edge
# 播报人物（TTS_ENGINE=edge 时生效）
# 女：zh-CN-XiaoxiaoNeural 晓晓 | zh-CN-XiaoyiNeural 晓伊
# 男：zh-CN-YunxiNeural 云希 | zh-CN-YunyangNeural 云扬 | zh-CN-YunjianNeural 云健
TTS_VOICE=zh-CN-XiaoxiaoNeural
VISION_ENABLED=true
WORKSPACE_ROOT=.
# 小派资料库总目录（图/音乐/文档）。换电脑只改这一项。空=用户主目录下的 PaiLib
PAI_LIB_ROOT=

# ---------- 时间（单位：秒）----------
# 说完停顿多久算一句结束。建议 0.6–2.0
# 越大：一句更不容易被切碎；越小：答得更快，但停顿稍长会被当成说完
VOICE_SILENCE_END=1.0
# 短于这个长度的声音不当一句。建议 0.2–0.8。越大越不容易把咳嗽/碰麦当说话
VOICE_MIN_UTTERANCE=0.4
# 一句最长，到点强制提交。建议 8–25。越大能说越长，卡住时也等更久
VOICE_MAX_UTTERANCE=15
# 她说完后再听多久；超时回待机。建议 5–20。越大越不用反复唤醒，也更占麦
VOICE_FOLLOWUP_SECONDS=10
# 刚开始听时，最多等多久开口；没人说话就回待机。建议 5–15
VOICE_START_TIMEOUT=8
# 待机唤醒词最长听几秒。建议 2–6。越大「你好小派，打开记事本」更能一次说完
WAKE_MAX_UTTERANCE=4.0

# ---------- 音量门槛（RMS，不是百分比）----------
# 判定「开始说话」。建议 0.001–0.008，默认 0.0025
# 越大：越不容易把风扇/键盘当开口（迟钝）；越小：小声也能触发（容易误触发）
VOICE_START_ENERGY=0.0025
# 判定「还在说」。建议 0.0005–0.003，且应小于 START。默认 0.0012
# 越大：声音一弱就当说完；越小：中间换气不容易被切断
VOICE_KEEP_ENERGY=0.0012
# 相对环境噪音的倍数，和上面两个取较大者当门槛。建议 START 6–12、KEEP 3–6
# 越大：嘈杂房间更稳；越小：远距离小声更容易听进
VOICE_START_RATIO=8.0
VOICE_KEEP_RATIO=4.0

# 全局热键，格式 CTRL+SHIFT+字母。不要用 F8（会开飞行模式）
VOICE_HOTKEY=CTRL+SHIFT+L

# ---------- 播报时开口打断 ----------
# 开播后前几秒不打断（避开她自己的喇叭回声）。建议 0.4–1.5
# 越大：越不容易自己打断自己；越小：你越早能插话
VOICE_BARGE_IN_GRACE=0.8
# 打断音量下限。建议 0.02–0.08，默认 0.035
# 越大：越不容易被回声/电视误打断；越小：轻轻说就能打断
VOICE_BARGE_IN_ENERGY=0.035
# 打断相对回声的倍数。建议 2–6。越大越稳，越小越好打断
VOICE_BARGE_IN_RATIO=3.0

# 待机唤醒：true=可以说「你好小派 / 嗨小派」；false=只靠热键、/listen、托盘
WAKEWORD_ENABLED=true
# 任务栏托盘图标。false=不驻留
TRAY_ENABLED=true

# 网页搜索：bing=必应（国内可直连） | auto=必应失败再试海外源（通常要代理）
WEB_SEARCH_BACKEND=bing
# 单次搜索最多等几秒。建议 5–15
WEB_SEARCH_TIMEOUT=8
# 仅当要走 Google 等海外源时填写，例如 http://127.0.0.1:7890
WEB_SEARCH_PROXY=

# 能力密钥（确认后由小派写入，也可手填。不要提交 git）
# 和风天气：https://dev.qweather.com/
# QWEATHER_API_KEY=
# Tushare 日线：https://tushare.pro/
# TUSHARE_TOKEN=
