# DeepSeek（必填，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 当前供应商：deepseek | openai | claude
LLM_PROVIDER=deepseek

# 预留：切换供应商时再填
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 存储与检索
SQLITE_PATH=data/personal_ai.db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 工作流
LOG_LEVEL=INFO
MAX_TOOL_ITERATIONS=3
SHORT_TERM_WINDOW=16

# 感官
VOICE_ENABLED=true
TTS_ENABLED=true
STT_ENGINE=sensevoice
STT_MODEL=base
SENSEVOICE_DIR=models/sensevoice
# 播报：edge=晓晓等神经网络语音（需联网）；sapi=系统慧慧（断网备用）
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
VISION_ENABLED=true
WORKSPACE_ROOT=.

# 语音会话（改这些数字后重启即可）
# 说完停顿多久算一句结束
VOICE_SILENCE_END=1.0
# 一句最短 / 最长（秒）
VOICE_MIN_UTTERANCE=0.4
VOICE_MAX_UTTERANCE=15
# 播报结束后继续听多久；超时回待机
VOICE_FOLLOWUP_SECONDS=10
# 点了 /listen 或热键后，最多等多久开口
VOICE_START_TIMEOUT=8
# 开口/保持的音量下限（越大越不容易误触发）
VOICE_START_ENERGY=0.0025
VOICE_KEEP_ENERGY=0.0012
VOICE_HOTKEY=CTRL+SHIFT+L
# 播报开口打断：开播后多少秒内不打断；音量下限与相对回声倍数
VOICE_BARGE_IN_GRACE=0.4
VOICE_BARGE_IN_ENERGY=0.02
VOICE_BARGE_IN_RATIO=2.5
